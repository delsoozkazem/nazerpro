# پورت اجرای سرور
PORT=4000

# کلید امضای JWT — در Production حتماً با یک مقدار تصادفی طولانی جایگزین شود
JWT_SECRET=dev-secret-change-in-production-please

# مسیر فایل دیتابیس SQLite (پیش‌فرض: data/nazerpro.db)
DB_PATH=./data/nazerpro.db

# ---- فقط برای مسیر استقرار Production با PostgreSQL (هنوز در کد فعال نیست) ----
# DATABASE_URL=postgresql://nazerpro:nazerpro@localhost:5432/nazerpro
